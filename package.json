{
  "name": "suishi-north-backtest",
  "version": "0.1.0",
  "private": true,
  "description": "随势向北股票趋势交易系统的回测与优化系统",
  "scripts": {
    "prepare": "husky && chmod +x .husky/pre-commit",
    "test": "python -m pytest",
    "acceptance": "python scripts/acceptance_check.py",
    "acceptance:smoke": "python scripts/acceptance_check.py --profile smoke"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
